# This template contains NO credentials. Copy it to .env.local for API mode only.
# ChatGPT sign-in: npm run dev (local host only; no API key required).
# Vercel: add these as server-side environment variables; never upload .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
APP_ORIGIN=

# Optional: move LOCAL ChatGPT credential storage to a private directory OUTSIDE
# the repository. Default: ~/.config/mcp-ui-lab-chatgpt/. No tokens in dist/.
# CHATGPT_DATA_DIR=

# Optional local port. OAuth uses http://127.0.0.1:<port>/auth/callback.
# PORT=5173
